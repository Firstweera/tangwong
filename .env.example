# TangWong — environment variables
# Copy to .env.local and fill in from your Supabase project
# (Supabase dashboard → Project Settings → API).
#
# Auth + profiles activate only when BOTH of these are set; otherwise the app
# falls back to the local-only guest identity (no backend required for dev).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Realtime transport switch (Phase 4.5.2 — Rooms + Realtime). Not used yet.
# false / unset = cross-tab (BroadcastChannel) · true = Supabase
VITE_USE_SUPABASE=
